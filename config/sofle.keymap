#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";  // ← ЭТА СТРОКА ОБЯЗАТЕЛЬНА

        default_layer {
            bindings = <
                &kp Q &kp W &kp E &kp R &kp T &rgb_ug RGB_TOG   &kp U &kp I &kp O &kp P &kp U &kp U
                &kp A &kp S &kp D &kp F &kp G &kp H   &kp J &kp K &kp L &kp SEMI &kp U &kp U
                &kp Z &kp X &kp C &kp V &kp B &kp N   &kp M &kp COMMA &kp DOT &kp FSLH &kp U &kp U
                &mo 1 &kp SPACE &kp RET &kp BSPC &kp TAB   &kp LSHFT &kp LCTRL &kp LALT &kp U &kp U
            >;
        };

        lower_layer {
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6    &kp N7 &kp N8 &kp N9 &kp N0 &kp U &kp U
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &kp U &kp U
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &kp U &kp U
                &trans &kp SPACE &kp RET &kp BSPC &kp TAB   &kp LSHFT &kp LCTRL &kp LALT &kp U &kp U
            >;
        };
    };
};

&led_strip {
    chain-length = <28>;
};
